<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/run_stat_tile_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/historyRunDateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/run_screen_secondary_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/historyRunDistanceText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/run_screen_primary_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/historyRunDurationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/run_screen_primary_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/historyRunAveragePaceText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/run_screen_primary_text"
        android:textSize="15sp" />

</LinearLayout>
