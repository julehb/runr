<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/runRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/run_screen_background"
    tools:context=".RunActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/halfwayGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/timerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toTopOf="@id/halfwayGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/elapsedTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/elapsed_time"
            android:textColor="@color/run_screen_secondary_text"
            android:textSize="18sp"
            app:layout_constraintBottom_toTopOf="@id/elapsedTimeChronometer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <Chronometer
            android:id="@+id/elapsedTimeChronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans"
            android:format="%s"
            android:textColor="@color/run_screen_primary_text"
            android:textSize="56sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/pauseRunButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/elapsedTimeLabel" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/pauseRunButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minWidth="132dp"
            android:minHeight="48dp"
            android:background="@drawable/start_run_button_background"
            android:backgroundTint="@null"
            android:elevation="4dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/pause_run"
            android:textAllCaps="false"
            android:textColor="@color/start_run_button_text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@id/resetRunButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/elapsedTimeChronometer" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/resetRunButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="132dp"
            android:minHeight="44dp"
            android:background="@drawable/start_run_button_background"
            android:backgroundTint="@null"
            android:elevation="4dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/reset_run"
            android:textAllCaps="false"
            android:textColor="@color/start_run_button_text"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@id/stopRunButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pauseRunButton" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/stopRunButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minWidth="132dp"
            android:minHeight="44dp"
            android:background="@drawable/start_run_button_background"
            android:backgroundTint="@null"
            android:elevation="4dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/stop_run"
            android:textAllCaps="false"
            android:textColor="@color/start_run_button_text"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/resetRunButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/map_placeholder_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/halfwayGuideline">

        <org.osmdroid.views.MapView
            android:id="@+id/runMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@color/map_status_overlay_background"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/locationStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/location_waiting"
                android:textColor="@color/run_screen_primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/locationCoordinatesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/location_coordinates_placeholder"
                android:textColor="@color/run_screen_secondary_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/distanceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/distance_placeholder"
                android:textColor="@color/run_screen_primary_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/paceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pace_placeholder"
                android:textColor="@color/run_screen_primary_text"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/mapAttributionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="@color/map_status_overlay_background"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:text="@string/map_attribution"
            android:textColor="@color/run_screen_primary_text"
            android:textSize="11sp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
