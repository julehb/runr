<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/runRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/run_screen_background"
    tools:context=".RunActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/halfwayGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.6" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/timerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toTopOf="@id/halfwayGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Chronometer
            android:id="@+id/elapsedTimeChronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:format="%s"
            android:textColor="@color/run_screen_primary_text"
            android:textSize="56sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/pauseRunButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.2"
            app:layout_constraintVertical_chainStyle="packed" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/pauseRunButton"
            style="@style/Widget.Runr.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="6dp"
            android:text="@string/pause_run"
            app:layout_constraintBottom_toTopOf="@id/runStatsContainer"
            app:layout_constraintEnd_toStartOf="@id/resetRunButton"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/elapsedTimeChronometer" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/resetRunButton"
            style="@style/Widget.Runr.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="@string/reset_run"
            app:layout_constraintBottom_toBottomOf="@id/pauseRunButton"
            app:layout_constraintEnd_toStartOf="@id/stopRunButton"
            app:layout_constraintStart_toEndOf="@id/pauseRunButton"
            app:layout_constraintTop_toTopOf="@id/pauseRunButton" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/stopRunButton"
            style="@style/Widget.Runr.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/stop_run"
            app:layout_constraintBottom_toBottomOf="@id/pauseRunButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/resetRunButton"
            app:layout_constraintTop_toTopOf="@id/pauseRunButton" />

        <LinearLayout
            android:id="@+id/runStatsContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="top"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pauseRunButton">

            <LinearLayout
                android:id="@+id/distanceStatsContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/run_stat_tile_background"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/distanceLabelText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="@string/distance_label"
                    android:textColor="@color/run_screen_secondary_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/distanceText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/distance_placeholder"
                        android:textColor="@color/run_screen_primary_text"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/paceStatsContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/run_stat_tile_background"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/paceLabelText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:text="@string/pace_label"
                        android:textColor="@color/run_screen_secondary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/paceUnitToggleTrack"
                        android:layout_width="68dp"
                        android:layout_height="32dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/pace_unit_toggle_track_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="2dp">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/paceUnitToggleButton"
                            android:layout_width="48dp"
                            android:layout_height="28dp"
                            android:layout_gravity="start|center_vertical"
                            android:background="@drawable/pace_unit_toggle_background"
                            android:backgroundTint="@null"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:text="@string/pace_unit_pace"
                            android:textAllCaps="false"
                            android:textColor="@color/timer_button_text"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null" />

                    </FrameLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/paceValuesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/currentPaceLabelText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:text="@string/current_pace_label"
                        android:textColor="@color/run_screen_primary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/currentPaceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:text="@string/current_pace_placeholder"
                        android:textColor="@color/run_screen_primary_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/averagePaceLabelText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:text="@string/average_pace_label"
                        android:textColor="@color/run_screen_primary_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/averagePaceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:text="@string/average_pace_placeholder"
                        android:textColor="@color/run_screen_primary_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/map_placeholder_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/halfwayGuideline">

        <org.osmdroid.views.MapView
            android:id="@+id/runMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/mapAttributionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:background="@color/map_status_overlay_background"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:text="@string/map_attribution"
            android:textColor="@color/run_screen_primary_text"
            android:textSize="11sp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
